  // Azure, NOT aws: the gateway's AWS/Bedrock route flakes on a large fraction of
  // streaming requests, returning HTTP 408 in ~0.6s with `litellm.Timeout:
  // BedrockException: Connection timed out ... time taken=0.004 seconds`. The message is
  // a red herring -- 0.004s is not a 5s connect timeout, it is the gateway rejecting the
  // request and mislabelling it.
  //
  // Re-measured 2026-09-23, and it has got worse. 20 sequential streaming requests with a
  // 0.4s gap, so this is not a concurrency or rate-limit artifact:
  //     aws/anthropic/bedrock-claude-opus-5-5    5/20 failed (all 408, 0.6-3.0s)
  //     azure/anthropic/claude-opus-5-5          0/20 failed
  // Concurrent 30-request runs agree: aws opus-5 5/30, aws opus-5-5 4/30, both azure 0/30.
  // Affects every Anthropic model on the aws/ prefix, no other provider prefix.
  //
  // It bites hardest when starting a session, which is why picking a non-AWS model first
  // and switching afterwards appeared to "fix" it: `opencode run` retries and rides out a
  // 1-failure burst, but the first request of a new session has no retry to hide behind.
  //
  // Switch back once the gateway's AWS route is fixed -- the model itself is identical.
  //
  // Thinking control, verified on the gateway 2026-09-23: newer Anthropic models
  // (opus-5-5, opus-5, opus-4-8, opus-4-7, sonnet-5) now HARD 400 on `reasoning_effort`
  // with "thinking.type.enabled is not supported for this model, use
  // thinking.type.adaptive and output_config.effort". So every `variants` entry on those
  // models was a guaranteed 400 and has been removed; they think adaptively instead.
  // `thinking: {type: adaptive}` is also rejected on Azure; only bare `output_config`
  // is accepted there, and it is then SILENTLY DROPPED (a bogus effort value passes, and
  // median completion tokens are identical at low vs max). On the AWS route
  // output_config.effort IS validated and honoured (low 1280 / medium 1492 / max 20000
  // median completion tokens), so steerable effort and a reliable route are currently
  // mutually exclusive for Opus 5.5. Older opus-4-6 / sonnet-4-6 / haiku-4-5 still honour
  // plain `reasoning_effort` on Azure and keep their variants.
  "model": "nvidia-inference/opus-5-5-azure",
  "small_model": "nvidia-inference/haiku-4-5-azure",
  // The hidden system agents (compaction, summary) send a toolless request over
  // history that contains tool-call/tool-result blocks. Anthropic-on-Bedrock and
  // Anthropic-on-Azure reject this ("doesn't support tool calling without tools="),
  // which broke auto-compaction on near-max-context Opus-4.8 sessions. Pin these
  // agents to a non-Anthropic model on the proxy (GPT-5.5, 1.05M ctx) which tolerates it.
  "agent": {
    "compaction": {
      "model": "nvidia-inference/gpt-5.5"
    },
    "summary": {
      "model": "nvidia-inference/gpt-5.5"
    }
  },
  "skills": {
    "paths": [
      "~/.agents/skills"
    ]
  },
  "permission": {
    // gpg-agent SIGHUP (gpgconf --reload/--kill) flushes ALL cached passphrases,
    // forcing a re-unlock of the GPG signing key. Agent sessions were doing this
    // while debugging commit signing, which is what made the key "lock up" every
    // few minutes. Require explicit confirmation instead of silently allowing it.
    "bash": {
      "gpgconf --reload*": "ask",
      "gpgconf --kill*": "ask",
      "*": "allow"
    },
    "skill": {
      "*": "allow",
      // Redundant with writing-skills (superpowers). From kimaki npm package.
      "new-skill": "deny"
    }
  }
}
